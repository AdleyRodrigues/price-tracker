# Discord
WEBHOOK_URL=
DISCORD_CELULAR_WEBHOOK_URL=
DISCORD_SUPERMERCADO_WEBHOOK_URL=
USER_ID=
CEP_DESTINO=01001-000

# Histórico de preços (libSQL) — opcional no tracker (soft-fail)
# Obrigatório para a API do dashboard
#
# Recomendado (dev local): SQLite em arquivo. O dashboard sincroniza
# automaticamente com a branch `historico-data` (publicada pelos GitHub Actions).
TURSO_DATABASE_URL=file:C:/caminho/para/data/historico.db
# TURSO_AUTH_TOKEN=   # só se usar libsql:// remoto (Turso Cloud)
#
# URL do SQLite publicado pelos Actions (default já aponta pro repo):
# HISTORICO_REMOTE_DB_URL=https://raw.githubusercontent.com/AdleyRodrigues/price-tracker/historico-data/historico.db

# Dashboard API (opcional)
# PORT=8787

