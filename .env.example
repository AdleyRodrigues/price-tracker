# Discord
WEBHOOK_URL=
DISCORD_CELULAR_WEBHOOK_URL=
DISCORD_SUPERMERCADO_WEBHOOK_URL=
USER_ID=
CEP_DESTINO=01001-000

# Histórico de preços (libSQL) — opcional no tracker (soft-fail)
# Obrigatório para a API do dashboard
#
# Recomendado: Turso Cloud (Actions + local apontam para o mesmo banco).
# Crie o DB em https://turso.tech e rode: turso db shell SEU_DB < sql/001_historico.sql
TURSO_DATABASE_URL=libsql://SEU_DB-ORG.turso.io
TURSO_AUTH_TOKEN=

# Offline / legado: SQLite em arquivo. Aí o dashboard ainda pode sincronizar
# com a branch `historico-data` (não usado pelos workflows atuais).
# TURSO_DATABASE_URL=file:C:/caminho/para/data/historico.db
# HISTORICO_SKIP_REMOTE_SYNC=1
# HISTORICO_REMOTE_DB_URL=https://raw.githubusercontent.com/AdleyRodrigues/price-tracker/<sha>/historico.db

# Dashboard API (opcional)
# PORT=8787

# ---------------------------------------------------------------------------
# APIs pagas de e-commerce (Fase 3) — opcionais
# Sem a chave, o scraper correspondente retorna [] e o pipeline manual segue.
# ---------------------------------------------------------------------------

# ReefAPI (KaBuM JSON: cash_price_brl = PIX, price_brl = cartão)
# https://reefapi.com/docs/kabum
REEF_API_KEY=

# GeckoAPI (ML / Amazon / Magalu / Shopee via POST /v1/extract)
# https://geckoapi.com.br/docs/
GECKO_API_KEY=
# Opcional: lista separada por vírgula (default: mercadolivre, amazon, magazineluiza)
# GECKO_TARGETS=mercadolivre.com.br,amazon.com.br,magazineluiza.com.br

# Apify (actors por loja — precisa do token + ID de cada actor)
# https://docs.apify.com/api/v2
APIFY_API_KEY=
# IDs no formato username~actor-name (ex.: minhaorg~kabum-scraper)
APIFY_ACTOR_KABUM=
APIFY_ACTOR_PICHAU=
APIFY_ACTOR_TERABYTE=
APIFY_ACTOR_FASTSHOP=
APIFY_ACTOR_ACER=

# Descontosml (MCP / HTTP futuro) — cupom por URL de produto ML
# DESCONTOSML_API_URL=
